# === Knowledge-RAG WhatsApp 环境变量模板 ===
# 用法：cp .env.example .env  然后把下面的值填成你自己的（.env 已在 .gitignore，绝不入库）。
# serve-whatsapp.sh 会自动 source 这个 .env，不用再手动 export。

# --- LLM 后端（便宜自动服务）---
OPENAI_API_KEY=sk-填你的key
KB_RAG_OPENAI_MODEL=gpt-4o-mini      # 便宜档，每问几厘；想更强改成 gpt-4o
KB_RAG_BACKEND=openai

# --- Twilio WhatsApp 沙箱 ---
TWILIO_ACCOUNT_SID=填你的AccountSID
TWILIO_AUTH_TOKEN=填你的AuthToken
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # 沙箱固定发送号

# --- 本地调试开关 ---
KB_RAG_SKIP_VALIDATION=1             # 跳过 Twilio 签名校验（本地/quick tunnel 调试用；上线正式域名后设 0）
